# ---------------------------------------------------------------------------
# Supabase  (the database; preferred over Google Sheets when both are set)
# ---------------------------------------------------------------------------
# Setup, once:
# 1. supabase.com -> new project -> wait for it to finish provisioning
# 2. Project Settings -> Data API -> copy the Project URL into SUPABASE_URL
# 3. Project Settings -> API Keys -> copy the *service_role* key
# 4. npx supabase link --project-ref <ref>
# 5. npx supabase db push          (creates the four tables)
# 6. npx tsx scripts/migrate-to-supabase.ts            (dry run)
#    npx tsx scripts/migrate-to-supabase.ts --apply    (copies the data in)
#
# The service_role key bypasses every row level policy. That is the access
# model here on purpose: this app has its own admin login and queries only ever
# run on the server. It follows that the key must NEVER be exposed to a
# browser, so it is not NEXT_PUBLIC_ and nothing client-side reads it.
# Real values go in .env.local, which is gitignored. Never in this file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Sheets  (leave everything below blank to run on local JSON storage)
# ---------------------------------------------------------------------------
# Setup, once:
# 1. Google Cloud Console -> create a project -> enable the "Google Sheets API"
# 2. IAM & Admin -> Service Accounts -> create one -> Keys -> Add key -> JSON
# 3. Open your Google Sheet -> Share -> add the service account's client_email
#    as an *Editor*.  (Most "403 permission denied" problems are this step.)

# The spreadsheet id is the long string between /d/ and /edit:
#   docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit#gid=170384010
#                                  ^------------------ this ------------------^      ^ NOT this ^
# (the number after #gid= is a tab id, not the spreadsheet id)
GOOGLE_SHEET_ID=

# --- Credentials: pick ONE of the two options below ------------------------

# OPTION A — service-account JSON key file (easiest for local development)
# Drop the file Google gave you in the project root as service-account.json and
# you are done; nothing else here needs setting. It is gitignored.
# To keep it elsewhere, or to reuse one you already have, point at it:
# GOOGLE_SERVICE_ACCOUNT_FILE=../lgf-automation/service-account.json
#
# OPTION B — environment variables (use this on Vercel and other hosts, where
# there is no filesystem to put a key file on). Copy client_email and
# private_key out of that same JSON file. Keep the quotes and the literal \n.
# These take precedence over the file if both are present.
# NEVER put a real key in THIS file — it is committed to the repo.
# Real values go in .env.local (gitignored), or use Option A above.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used when generating shareable affiliate links. Leave blank in
# development and the current request host is used.
NEXT_PUBLIC_BASE_URL=

# Set to false to stop logging landing-page views to the Visits tab.
TRACK_VISITS=true

# ---------------------------------------------------------------------------
# Lead capture form
# ---------------------------------------------------------------------------
# Off by default: following an affiliate link records the visit and forwards
# straight to the destination. Set to "on" to bring back the landing page that
# collects a name and email first — the page, the form and the Submissions tab
# are all still there, just hidden.
# CAPTURE_FORM=on

# With the form on, every saved lead gets a short reference and it is appended
# to the merchant URL on the way out, so:
#   https://www.cardratings.com/bestcards?src=714025&var2=1412
# is followed as:
#   https://www.cardratings.com/bestcards?src=714025&var2=1412&var3=k3m9x2q7hz04
#
# var3 because QuinStreet passes it through to its reporting untouched, and
# var2 is already the placement id inside each link's destination. The same
# reference is the lead's id in the Submissions tab and is shown on the
# dashboard, so an approval reported against a var3 weeks later can be traced
# to the person who filled the form.
#
# Set this to another parameter to move it, or to an empty string to append
# nothing. Only leads that were actually saved carry one: a honeypot forward
# gets the plain URL, because a reference matching no row is worse than none.
# LEAD_ID_PARAM=var3

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# The dashboard shows lead names, emails and phone numbers, so it is gated as
# soon as there is anything here to sign a session with. Landing pages and form
# submissions stay public.
#
# There are two kinds of account:
#
#   1. THIS one, from the environment. Always an admin, never in the database.
#      It is how you create the first database account, and how you get back in
#      if the database ones ever go wrong. Keep it.
#   2. Everyone else, created by an admin on the People page and stored in
#      Supabase. Each is either an admin (sees everything) or an affiliate
#      (bound to one tracking key, sees only that key's links, leads and
#      earnings). Passwords are generated on creation, shown once, and stored
#      only as a PBKDF2 hash — there is no way to read one back, only to reset.
#
# Accounts need Supabase. Without it this env account is the only way in.
ADMIN_PASSWORD=
ADMIN_USER=admin

# How long a sign-in lasts before it has to be repeated. Default 12 hours.
# SESSION_HOURS=12

# Signs the session cookie. Falls back to ADMIN_PASSWORD when unset, which
# means changing the password signs everyone out — fine with one account, but
# with affiliates it signs all of them out too. Set an explicit secret (any long
# random string) so the two are independent.
# SESSION_SECRET=

# A production build with nothing to sign in with serves 503 on the admin pages
# rather than exposing them. This overrides that for a throwaway demo — and is
# refused anyway once SUPABASE_URL or GOOGLE_SHEET_ID is set, because at that
# point the rows behind those pages are real people's.
# ALLOW_OPEN_ADMIN=true

# HTTP Basic (curl -u admin:...) for the env account. Off unless set: a
# credential presented on every request, with no session behind it and no
# lockout, is a password-guessing oracle. When on, it is rate limited.
# ALLOW_BASIC_AUTH=true

# ---------------------------------------------------------------------------
# Behind a proxy
# ---------------------------------------------------------------------------
# Which header carries the real client IP, for rate limiting and the visit log.
#
# Nothing is trusted unless named here, because a header's name says nothing
# about who set it: off Vercel, anyone can send their own x-real-ip and so pick
# their own rate-limit bucket, which turns every limit in the app — including
# the one in front of the password — into a formality. Unset means no header is
# believed and every request shares one bucket. On Vercel this is automatic.
# TRUSTED_PROXY_HEADER=x-forwarded-for
#
# How many proxies sit in front of the app. x-forwarded-for grows left to right,
# so the value is read this many entries from the RIGHT — a client prepending
# fake hops cannot move it.
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# QuinStreet Media Platform (QMP) reporting API  -> /reports
# ---------------------------------------------------------------------------
# Issued in QMP under the API keys section. The key is the username and the
# secret is the password of an HTTP Basic call that returns a bearer token.
# NEVER put the real values in THIS file. They go in .env.local (gitignored).
#
# These prefixed names are the only ones read. Bare CLIENT_ID / CLIENT_SECRET
# used to work as a fallback and no longer do: those names belong to nobody in
# particular, so on a host where another integration defines them, the first
# visit to /reports would have sent that integration's secret to QuinStreet.
QMP_API_KEY=
QMP_API_SECRET=

# The report /reports pulls. QMP has no endpoint that lists saved reports, so
# this is named here rather than chosen in the page. Get it from QMP: Reports
# -> Custom Reports -> open the report -> Download Via API, then take the last
# segment of the URL. Pasting the whole URL works too.
REPORT_ID=

# Which QMP surface the credentials belong to. "pub" for Publisher Services,
# "client" for a client login. The connection check on /reports prints the
# permissions the token came back with, which is how you confirm this.
# QMP_APP=pub

# Reporting host. Only change this to point at a QMP staging environment.
# QMP_BASE_URL=https://reporting.qmp.ai

# Where to file approvals whose Sub ID matches no link.
#
# Off unless set, because attributing somebody else's approval to a person is
# worse than refusing to file it. Turn it on when the report has no usable
# tracking key: report 93440, for instance, carries the same Sub ID on every
# row ("JavaScriptTransition_JSWidget", QuinStreet's own widget id), so without
# this every approval in it is unattributable and nothing syncs.
# QMP_DEFAULT_SLUG=cash-back

# ---------------------------------------------------------------------------
# Onboarding
# ---------------------------------------------------------------------------

# The key that seals the two numbers new affiliates hand over: the taxpayer
# number on their W-9 and their bank account number. AES-256-GCM, and the
# column holds ciphertext, so reading the database and holding this key are two
# separate compromises.
#
# Any long random string. 64 hex characters or 32 bytes of base64 are used as
# the key directly; anything else is stretched with scrypt, so a passphrase is
# fine. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Without it the W-9 and bank steps refuse to accept anything rather than
# storing an SSN in the clear. Losing it means those two numbers cannot be read
# back and have to be collected again — which is the right way round.
ONBOARDING_SECRET_KEY=

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
# Posts a line to one channel every time an approval is recorded, by hand or
# by a report sync. Off unless this is set, and a channel that cannot be
# reached never stops an approval being recorded.
#
# Setup, once:
# 1. api.slack.com/apps -> Create New App -> From scratch, pick your workspace
# 2. Incoming Webhooks -> turn on -> Add New Webhook to Workspace
# 3. Choose the channel; Slack hands back a URL starting https://hooks.slack.com/
#
# The URL *is* the permission to post in that channel, so it belongs in
# .env.local and in your host's settings, never in this file.
#
# A message reads:
#
#   LEDGER - AFFILIATE APPROVAL 🎉
#   Affiliate Name: Gimson Recilla
#   CARD: Best Cards | Client Jefferson Florez · Chase Freedom Unlimited(R)
#   Approved: 23 Sept 2026
#
# Never an amount, an affiliate's share or the commission rate: a channel is
# read by whoever is invited to it, and the figures live behind the sign-in.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Sends the one message this app sends: "your affiliate account is approved".
# Resend's API key, from resend.com. Without it an admin can still approve
# somebody, and is told plainly that nothing was emailed.
RESEND_API_KEY=

# Who it comes from. Must be an address on a domain verified with the provider,
# or every send is refused. A name in front of it is optional:
#
#   EMAIL_FROM=Ledger <noreply@yourdomain.com>
EMAIL_FROM=

# Where replies go, if that is not the from address. Optional.
EMAIL_REPLY_TO=
